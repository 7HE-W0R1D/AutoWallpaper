<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F6EDFF" />
        </shape>
    </item>
    <!-- Organic Blobs -->
    <item android:top="20dp" android:left="-30dp">
        <shape android:shape="oval">
            <solid android:color="#E0F7FA" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>
    <item android:bottom="-40dp" android:right="-20dp">
        <shape android:shape="oval">
            <solid android:color="#F3E5F5" />
            <size android:width="220dp" android:height="220dp" />
        </shape>
    </item>
</layer-list>
